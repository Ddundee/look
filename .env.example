# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values before running
# `docker compose up -d`. Never commit the real .env file.
# ---------------------------------------------------------------------------

# ---- Networking -------------------------------------------------------------
# Host/interface the containers bind to. 0.0.0.0 makes the services reachable
# from localhost, your LAN, and Tailscale (once Tailscale is installed on the
# host) without any extra configuration. See docs/TAILSCALE.md.
BIND_HOST=0.0.0.0

# Ports published on the host. Change if they collide with something else.
BACKEND_PORT=8000
MCP_PORT=8001
FRONTEND_PORT=3000

# Note: the frontend reaches the backend internally at http://backend:8000
# (the docker-compose service name). That's baked into the frontend image
# at build time (see frontend/Dockerfile) rather than read from this file —
# only edit it there if you rename the `backend` service below.

# ---- Database -----------------------------------------------------------
# "postgres" (recommended, used by docker-compose) or "sqlite" (simple local dev)
DB_ENGINE=postgres

POSTGRES_USER=todo_app
POSTGRES_PASSWORD=change_me_to_a_long_random_value
POSTGRES_DB=todo_app
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Only used when DB_ENGINE=sqlite (e.g. running the backend directly on your
# laptop without Docker/Postgres).
SQLITE_PATH=./data/todo-app.db

# ---- Authentication -------------------------------------------------------
# Long random secret used as a Bearer token for the REST API and the MCP
# server. Generate one with: openssl rand -hex 32
API_TOKEN=change_me_to_a_long_random_token

# Secret used to sign web UI session cookies (JWT). Generate with the same
# command as above. Must be different from API_TOKEN.
SESSION_SECRET=change_me_to_a_different_long_random_value

# Seed credentials for the single admin web-UI account. Only used the first
# time the app starts (when no user exists yet); after that, change your
# password is not exposed in V1, so update these and recreate the volume, or
# update the DB directly if you need to rotate it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_to_a_strong_password

# Session cookie lifetime, in hours.
SESSION_TTL_HOURS=720

# ---- App behavior ---------------------------------------------------------
# IANA timezone used to compute "today", due dates, and recurrence.
APP_TIMEZONE=America/New_York

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Set to "true" to auto-create the seed categories/demo data on first boot.
SEED_DEMO_DATA=false

# ---- OpenAI Secure MCP Tunnel (optional) ----------------------------------
# Only needed if you run `docker compose --profile openai-tunnel up -d` to
# let ChatGPT/Codex/the Responses API reach the `mcp` service over an
# outbound-only tunnel (no inbound port opened). See docs/DEPLOYMENT.md.
# Created at https://platform.openai.com/settings/organization/tunnels
OPENAI_TUNNEL_ID=
# Runtime API key with Tunnels Read+Use, from
# https://platform.openai.com/settings/organization/api-keys
OPENAI_TUNNEL_API_KEY=

# ---- Self-update ------------------------------------------------------------
# Where published images come from (the workflow pushes
# <prefix>-backend, -frontend and -updater). Change for a fork.
IMAGE_PREFIX=ghcr.io/ddundee/look
# GitHub repo whose publish workflow the updater watches.
UPDATER_GITHUB_REPO=Ddundee/look
# Internal URL the backend uses to reach the updater. Set it empty to turn
# in-app updates off.
UPDATER_URL=http://updater:8080
